{
  "version": 1,
  "quests": [
    {
      "id": "gate-lost",
      "title": "阿忠伯的失物招領",
      "zone": "gate",
      "npc": "guard-chung",
      "description": "阿忠伯保管著一張花朵失物卡，幫他比對公告、問過小潔，再決定怎麼讓失主領回。",
      "reward": "阿忠伯的失物招領紀念章",
      "steps": [
        {
          "id": "errand-1",
          "target": "npc:guard-chung",
          "text": "向阿忠伯領取失物卡：卡片上畫著一朵小花。",
          "kind": "interact",
          "radius": 4,
          "lines": [
            {
              "who": "guard-chung",
              "text": "有人掉了這張花朵卡片。你拿著比對公告，再問問活動中心的小潔。"
            }
          ]
        },
        {
          "id": "errand-2",
          "target": "spot:gate-notice",
          "text": "查看校門旁的失物公告板，確認還沒有人登記這張卡片。",
          "kind": "interact",
          "radius": 3,
          "lines": [
            {
              "who": "player",
              "text": "公告板上沒有人登記花朵卡片，去問小潔吧。"
            }
          ]
        },
        {
          "id": "errand-3",
          "target": "npc:clerk-jie",
          "text": "向小潔詢問是否有人來找花朵卡片。",
          "kind": "interact",
          "radius": 4,
          "lines": [
            {
              "who": "clerk-jie",
              "text": "還沒有人來認領。請交回警衛室，讓失主有地方詢問。"
            }
          ]
        },
        {
          "id": "return",
          "target": "npc:guard-chung",
          "text": "回到阿忠伯身邊，決定如何妥善交還這張花朵卡片。",
          "radius": 4,
          "choices": [
            {
              "id": "a",
              "label": "公告寫下拾獲處，認領時核對圖案",
              "result": "我在公告寫下拾獲地點，圖案不公開，認領的人說對了再領回。"
            },
            {
              "id": "b",
              "label": "交給警衛室登記保管",
              "result": "卡片先鎖進警衛室的失物櫃，等失主來核對。"
            }
          ],
          "lines": [
            {
              "who": "guard-chung",
              "text": "卡片帶回來了。你覺得公告該怎麼寫，才能交回給真正的失主？"
            }
          ]
        }
      ],
      "accept": {
        "near": "npc:guard-chung",
        "chapterDone": "c1-gate"
      },
      "absent": {
        "night": "阿忠伯夜裡巡到海堤，白天或傍晚才回校門警衛室。"
      }
    },
    {
      "id": "gate-mia",
      "title": "Mia 的第一天",
      "zone": "library",
      "npc": "intl-mia",
      "description": "Mia 留在原處等候；自己走訪行政區和閱讀區，再回來分享方向。",
      "reward": "Mia 的第一天紀念章",
      "steps": [
        {
          "id": "errand-1",
          "target": "npc:intl-mia",
          "text": "聽 Mia 說明想認識的地點。",
          "kind": "interact",
          "radius": 4,
          "lines": [
            {
              "who": "intl-mia",
              "text": "我第一天來，想知道行政區的服務台怎麼走。"
            },
            {
              "who": "intl-mia",
              "text": "這裡的閱讀區適不適合看書？你能幫我看看嗎？"
            }
          ]
        },
        {
          "id": "errand-2",
          "target": "spot:admin-service-sign",
          "text": "找到行政大樓前的服務台指示牌，記下方向。",
          "kind": "interact",
          "radius": 3,
          "lines": [
            {
              "who": "player",
              "text": "指示牌寫著服務台就在行政大樓這一側，把方向記下來了。"
            }
          ]
        },
        {
          "id": "errand-3",
          "target": "spot:library-reading-desk",
          "text": "到圖資大樓前廣場的閱讀桌看看。",
          "kind": "interact",
          "radius": 3,
          "lines": [
            {
              "who": "player",
              "text": "閱讀桌上擺著幾本書，坐下來看書應該不錯。回去向 Mia 說說。"
            }
          ]
        },
        {
          "id": "return",
          "target": "npc:intl-mia",
          "text": "回到 Mia 身邊，告訴她服務台方向，並推薦閱讀的地方。",
          "radius": 4,
          "choices": [
            {
              "id": "a",
              "label": "介紹廣場的閱讀桌",
              "result": "廣場的閱讀桌聽起來很棒，我會照你的方向筆記去看看。"
            },
            {
              "id": "b",
              "label": "介紹有遮陽傘的座位",
              "result": "有遮陽傘的座位聽起來很好，我帶本書就去坐坐。"
            }
          ],
          "lines": [
            {
              "who": "intl-mia",
              "text": "你回來了！服務台怎麼走我聽懂了。閱讀區有什麼值得先看？"
            }
          ]
        }
      ],
      "accept": {
        "near": "npc:intl-mia",
        "chapterDone": "c4-library"
      },
      "absent": {
        "night": "Mia 已離校休息，白天在圖書館，傍晚在長廊。"
      }
    },
    {
      "id": "tunnel-leaflet",
      "title": "迎新傳單飛走了",
      "zone": "tunnel-west",
      "npc": "s1",
      "description": "替小禾撿回洞口兩疊傳單，再找她一起整理。",
      "reward": "迎新傳單飛走了紀念章",
      "steps": [
        {
          "id": "errand-1",
          "target": "npc:s1",
          "text": "向小禾領取空資料夾，準備幫忙整理迎新傳單。",
          "kind": "interact",
          "radius": 4,
          "lines": [
            {
              "who": "s1",
              "text": "學長姊託我發的傳單被風吹到洞口了，有兩疊。幫我撿回來再來找我好嗎？"
            }
          ]
        },
        {
          "id": "errand-2",
          "target": "spot:tunnel-leaflets-mouth",
          "text": "在隧道洞口旁撿起第一疊傳單。",
          "kind": "interact",
          "radius": 3,
          "lines": [
            {
              "who": "player",
              "text": "洞口這疊收好了，再查看內側。"
            }
          ]
        },
        {
          "id": "errand-3",
          "target": "spot:tunnel-leaflets-inside",
          "text": "到洞口內側，收好第二疊傳單。",
          "kind": "interact",
          "radius": 3,
          "lines": [
            {
              "who": "player",
              "text": "內側這疊也找到了，回去交給小禾。"
            }
          ]
        },
        {
          "id": "return",
          "target": "npc:s1",
          "text": "把兩疊傳單交還小禾，選擇資料夾的整理方式。",
          "radius": 4,
          "choices": [
            {
              "id": "a",
              "label": "依活動時間整理",
              "result": "依活動時間排好了，想參加的人可以直接查下一場。"
            },
            {
              "id": "b",
              "label": "依社團種類整理",
              "result": "社團種類分開了，想找哪個攤位都能翻到那一頁。"
            }
          ],
          "lines": [
            {
              "who": "s1",
              "text": "兩疊都找回來了！資料夾要怎麼分比較好找？"
            }
          ]
        }
      ],
      "accept": {
        "near": "npc:s1",
        "chapterDone": "c2-tunnel"
      },
      "absent": {
        "sunset": "小禾傍晚在行政大樓附近，白天才在校門。",
        "night": "小禾夜裡在行政大樓附近，白天才在校門。"
      }
    },
