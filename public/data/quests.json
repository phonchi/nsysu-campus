  "quests": [
    {
      "id": "gate-lost",
      "title": "阿忠伯的失物招領",
      "zone": "gate",
      "npc": "guard-chung",
      "description": "阿忠伯保管著一張花朵失物卡，幫他比對公告、翻過警衛室旁的失物登記簿，再決定怎麼讓失主領回。",
      "reward": "失物保管回條",
      "revision": 2,
      "steps": [
        {
          "id": "errand-1",
          "target": "npc:guard-chung",
          "text": "向阿忠伯領取失物卡：卡片上畫著一朵小花。",
          "kind": "interact",
          "radius": 4,
          "lines": [
            {
              "who": "guard-chung",
              "text": "有人掉了這張花朵卡片。你拿著比對公告，再翻翻警衛室旁的失物登記簿。"
            }
          ]
        },
        {
          "id": "errand-2",
          "target": "spot:gate-notice",
          "text": "查看校門旁的失物公告板，確認還沒有人登記這張卡片。",
          "kind": "interact",
          "radius": 3,
          "lines": [
            {
              "who": "player",
              "text": "公告板上沒有人登記花朵卡片，再去翻登記簿。"
            }
          ]
        },
        {
          "id": "errand-3",
          "target": "spot:gate-lost-ledger",
          "text": "翻閱警衛室旁的失物登記簿，確認沒有人來問過花朵卡片。",
          "kind": "interact",
          "radius": 3,
          "lines": [
            {
              "who": "player",
              "text": "登記簿上沒有人問過花朵卡片。把卡片交回阿忠伯吧。"
            }
          ]
        },
        {
          "id": "return",
          "target": "npc:guard-chung",
          "text": "回到阿忠伯身邊，決定如何妥善交還這張花朵卡片。",
          "radius": 4,
          "choices": [
            {
              "id": "a",
              "label": "公告寫下拾獲處，認領時核對圖案",
              "result": "我在公告寫下拾獲地點，圖案不公開，認領的人說對了再領回。"
            },
            {
              "id": "b",
              "label": "交給警衛室登記保管",
              "result": "卡片先鎖進警衛室的失物櫃，等失主來核對。"
            }
          ],
          "lines": [
            {
              "who": "guard-chung",
              "text": "卡片帶回來了。你覺得公告該怎麼寫，才能交回給真正的失主？"
            }
          ]
        }
      ],
      "accept": {
        "near": "npc:guard-chung",
        "chapterDone": "c1-gate",
        "times": [
          "day",
          "sunset"
        ]
      },
      "absent": {
        "night": "阿忠伯夜裡巡到海堤，白天或傍晚才回校門警衛室。"
      },
      "legacyRewards": [
        "阿忠伯的失物招領紀念章"
      ],
      "completionRewards": [
